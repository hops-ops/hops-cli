name: Publish Image

on:
  workflow_call:

env:
  # renovate: datasource=github-releases depName=railwayapp/railpack extractVersion=^v(?<version>.*)$
  RAILPACK_VERSION: "0.38.0"
  IMAGE_REPOSITORY: __IMAGE_REPOSITORY__

jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@37fe631027851001ddb9b187196cc803df7f5f0e # v4

      - name: Log in to GHCR
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve image tag
        id: image
        shell: bash
        run: |
          if [ "${GITHUB_EVENT_NAME}" = "pull_request" ]; then
            tag="pr-${{ github.event.pull_request.number }}-${{ github.event.pull_request.head.sha }}"
          else
            tag="${GITHUB_REF_NAME}"
          fi
          if [ -z "${tag}" ]; then
            echo "Unable to derive an image tag for ${GITHUB_EVENT_NAME}" >&2
            exit 1
          fi
          echo "tag=${tag}" >> "${GITHUB_OUTPUT}"

      - name: Install pinned Railpack release
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          asset="railpack-v${RAILPACK_VERSION}-x86_64-unknown-linux-musl.tar.gz"
          mkdir -p "${RUNNER_TEMP}/railpack-bin"
          gh release download "v${RAILPACK_VERSION}" \
            --repo railwayapp/railpack \
            --pattern "${asset}" \
            --dir "${RUNNER_TEMP}" \
            --clobber
          digest=$(gh api "repos/railwayapp/railpack/releases/tags/v${RAILPACK_VERSION}" \
            --jq ".assets[] | select(.name == \"${asset}\") | .digest")
          if [[ "${digest}" != sha256:* ]]; then
            echo "Railpack release asset did not publish a SHA-256 digest" >&2
            exit 1
          fi
          echo "${digest#sha256:}  ${RUNNER_TEMP}/${asset}" | sha256sum --check
          tar -xzf "${RUNNER_TEMP}/${asset}" -C "${RUNNER_TEMP}/railpack-bin"
          echo "${RUNNER_TEMP}/railpack-bin" >> "${GITHUB_PATH}"

      - name: Prepare Railpack build plan
        shell: bash
        run: |
          railpack prepare --plan-out "${RUNNER_TEMP}/railpack-plan.json" .

      - name: Build and publish image
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7
        with:
          context: .
          file: ${{ runner.temp }}/railpack-plan.json
          push: true
          tags: ${{ env.IMAGE_REPOSITORY }}:${{ steps.image.outputs.tag }}
          build-args: |
            BUILDKIT_SYNTAX=ghcr.io/railwayapp/railpack-frontend:v0.38.0@sha256:b66c90368efcf6f2966cfa504cdbde93af7ba6092d676e0c7604cbc5ddf3acec
          cache-from: type=registry,ref=${{ env.IMAGE_REPOSITORY }}:buildcache
          cache-to: type=registry,ref=${{ env.IMAGE_REPOSITORY }}:buildcache,mode=max
