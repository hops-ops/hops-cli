name: Release and Promote Staging

on:
  push:
    tags:
      - "v*.*.*"

permissions:
  contents: write
  issues: write
  packages: write
  pull-requests: write

jobs:
  publish-image:
    name: Publish Image
    uses: ./.github/workflows/publish-image.yaml

  github-release:
    name: GitHub Release
    needs: publish-image
    uses: unbounded-tech/workflow-simple-release/.github/workflows/workflow.yaml@667d60d6fc858aefa64952556e4d17e98b95b5af # v2.1.4
    with:
      tag: ${{ github.ref_name }}
      name: ${{ github.ref_name }}

  promote-staging:
    name: Promote Staging
    needs: publish-image
    uses: hops-ops/workflows-gitops/.github/workflows/argocd-promote-helm.yaml@15299bfba8ca3eb0412d0973cff6307f6bee7096 # v2.1.1
    secrets:
      GH_APP_ID: ${{ secrets.GH_APP_ID }}
      GH_APP_KEY: ${{ secrets.GH_APP_KEY }}
    with:
      auth_mode: app
      promotion_chart_path: .gitops/promote
      destination_path: .gitops/deploy/helm/templates
      environment_repository: __STAGING_REPOSITORY__
      environment_name: staging
      project: __PROJECT__
      name: __APP_NAME__
      promotion_mode: direct
      values: |
        image:
          repository: __IMAGE_REPOSITORY__
          tag: ${{ github.ref_name }}
