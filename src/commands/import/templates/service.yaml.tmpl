apiVersion: v1
kind: Service
metadata:
  name: __APP_NAME__
  labels:
    app.kubernetes.io/name: __APP_NAME__
spec:
  type: {{ .Values.service.type }}
  selector:
    app.kubernetes.io/name: __APP_NAME__
  ports:
    - name: http
      port: {{ .Values.service.port }}
      targetPort: http
      protocol: TCP
