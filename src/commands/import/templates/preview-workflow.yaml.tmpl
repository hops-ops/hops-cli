name: Preview

on:
  pull_request:
    branches:
      - __DEFAULT_BRANCH__
    types:
      - labeled
      - opened
      - reopened
      - synchronize
      - unlabeled
      - closed

permissions:
  contents: write
  issues: write
  packages: write
  pull-requests: write

jobs:
  publish-image:
    name: Publish Preview Image
    if: >-
      github.event.action != 'closed' &&
      github.event.pull_request.head.repo.full_name == github.repository &&
      contains(github.event.pull_request.labels.*.name, 'preview')
    uses: ./.github/workflows/publish-image.yaml

  promote-preview:
    name: Promote Preview
    if: >-
      github.event.action != 'closed' &&
      github.event.pull_request.head.repo.full_name == github.repository &&
      contains(github.event.pull_request.labels.*.name, 'preview')
    needs: publish-image
    uses: hops-ops/workflows-gitops/.github/workflows/argocd-promote-helm.yaml@6f50d1ded5ab0336cd97008886c7147a3da5c585 # v2.0.0
    secrets:
      GH_APP_ID: ${{ secrets.GH_APP_ID }}
      GH_APP_KEY: ${{ secrets.GH_APP_KEY }}
    with:
      auth_mode: app
      promotion_chart_path: .gitops/promote
      destination_path: .gitops/deploy/helm/templates
      environment_repository: __PREVIEW_REPOSITORY__
      environment_name: preview
      project: __PROJECT__
      name: __APP_NAME__
      preview: true
      promotion_mode: pull-request-merge
      values: |
        image:
          repository: __IMAGE_REPOSITORY__
      comment: |
        Preview promoted for `__APP_NAME__` at `pr-${{ github.event.pull_request.number }}-${{ github.event.pull_request.head.sha }}`.

  remove-preview:
    name: Remove Preview
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository &&
      (github.event.action == 'closed' ||
      (github.event.action == 'unlabeled' && github.event.label.name == 'preview'))
    uses: hops-ops/workflows-gitops/.github/workflows/preview-cleanup.yaml@6f50d1ded5ab0336cd97008886c7147a3da5c585 # v2.0.0
    secrets:
      GH_APP_ID: ${{ secrets.GH_APP_ID }}
      GH_APP_KEY: ${{ secrets.GH_APP_KEY }}
    with:
      auth_mode: app
      environment_repository: __PREVIEW_REPOSITORY__
      destination_path: .gitops/deploy/helm/templates
      name: __APP_NAME__
      promotion_mode: pull-request-merge
